# FastAPI
FASTAPI_ENV=development
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_RELOAD=true

# Configure at least one real provider key before executing tasks
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Security: replace with long random values; never commit your actual .env
API_KEY=replace-with-a-long-random-api-key
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=postgresql://postgres:password@localhost:5432/agent_baj
SQLALCHEMY_ECHO=false
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
LOG_LEVEL=INFO
MAX_ITERATIONS=10
TIMEOUT=300
